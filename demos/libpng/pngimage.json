{
    "projectName": "pngimage",
    "target_type": "exe",
    "compiler": "gxx",
    "ref": [{"url": "https://github.com/pnggroup/libpng.git", "branch": "libpng16", "name": "libpng"}],
    "source": [".antel/refs/libpng/contrib/libtests/pngimage.c"],
    "include_directories": [],
    "compile_args": ["-O2", "-Wall", "-DPNG_INTEL_SSE_OPT=1", "-I.antel/build/libpng-generated", "-I.antel/refs/libpng"],
    "link_args": [".antel/build/png16_shared/libpng16.so"],
    "rpath": ["$ORIGIN/../png16_shared"],
    "data_files": [
        {"from": ".antel/refs/libpng/contrib/pngsuite", "to": "testdata/pngsuite"}
    ]
}
