{
    "projectName": "json-c",
    "target_type": "shared",
    "compiler": "gxx",
    "ref": [{"url": "https://github.com/json-c/json-c.git", "branch": "master", "name": "json-c"}],
    "before_build": [
        {
            "command": ["python3", "prepare_json_c.py"],
            "outputs": [".antel/build/json-c-config/config.h", ".antel/build/json-c-config/json_config.h", ".antel/build/json-c-config/json.h", ".antel/build/json-c-config/apps_config.h"]
        }
    ],
    "source": [
        ".antel/refs/json-c/arraylist.c",
        ".antel/refs/json-c/debug.c",
        ".antel/refs/json-c/json_c_version.c",
        ".antel/refs/json-c/json_object.c",
        ".antel/refs/json-c/json_object_iterator.c",
        ".antel/refs/json-c/json_tokener.c",
        ".antel/refs/json-c/json_util.c",
        ".antel/refs/json-c/json_visit.c",
        ".antel/refs/json-c/linkhash.c",
        ".antel/refs/json-c/printbuf.c",
        ".antel/refs/json-c/random_seed.c",
        ".antel/refs/json-c/strerror_override.c",
        ".antel/refs/json-c/json_pointer.c",
        ".antel/refs/json-c/json_patch.c"
    ],
    "include_directories": [],
    "compile_args": [
        "-O2",
        "-Wall",
        "-fPIC",
        "-D_GNU_SOURCE",
        "-I.antel/refs/json-c",
        "-I.antel/build/json-c-config"
    ],
    "link_args": ["-Wl,--version-script=.antel/refs/json-c/json-c.sym", "-lm"],
    "version": "5.5.0"
}
